# Copia este archivo como `.env` y llena los valores.
# El `.env` real NUNCA se sube al repo (ya está en .gitignore).

# --- Base de datos (obligatorio) ---------------------------------------
# Local con Docker:
#   docker run -d --name olivo-db -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=olivosport -p 5432:5432 postgres:16-alpine
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/olivosport
# En Supabase: Project Settings -> Database -> Connection string (URI).
# Si la contraseña tiene caracteres raros (@, #, /), hay que url-encodearlos.

# --- Seguridad (obligatorio) -------------------------------------------
# Con la que se firman los JWT. Generar una distinta por ambiente con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la cambias, todos los access tokens vigentes dejan de servir.
SECRET_KEY=

# "local" o "production". En production la cookie del refresh token sale
# con Secure=True, o sea que solo viaja por HTTPS.
ENVIRONMENT=local

# --- Sesiones (opcional, estos son los valores por defecto) ------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# --- Rate limit (opcional) ---------------------------------------------
# Cuántos proxies hay delante de la app: en Render es 1, corriendo
# directo es 0. Si queda en 0 estando detrás de un proxy, TODOS los
# usuarios comparten el mismo cupo (el proxy es una sola IP).
TRUSTED_PROXY_HOPS=0

# Con más de una instancia hace falta un contador compartido, si no cada
# una permite el límite completo por su cuenta. Para usar Redis hay que
# instalar también el cliente:  pip install "limits[redis]"
# RATE_LIMIT_STORAGE_URI=redis://default:PASSWORD@HOST:6379
RATE_LIMIT_STORAGE_URI=memory://

# --- Google OAuth (opcional; sin esto, /auth/google no funciona) -------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (tipo "Web application"). Es el MISMO client id que usa el frontend.
GOOGLE_CLIENT_ID=

# --- Supabase Storage (opcional; sin esto no se suben imágenes) --------
# El bucket tiene que llamarse `product-images` (ver app/core/storage.py).
SUPABASE_URL=
# La `service_role` key, NO la `anon`: es la que puede escribir en el
# bucket. Es secreta, nunca la pongas en el frontend.
SUPABASE_KEY=

# --- Wompi (opcional; sin esto no se puede cobrar) ---------------------
# Dashboard de Wompi -> Desarrolladores. En sandbox las llaves empiezan
# con pub_test_ / prv_test_; en producción, con pub_prod_ / prv_prod_.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# "Secreto de integridad": firma el monto del checkout.
WOMPI_INTEGRITY_SECRET=
# "Secreto de eventos": firma los webhooks que manda Wompi. Sin este
# valor, el webhook responde 500 y rechaza TODOS los eventos.
WOMPI_EVENTS_SECRET=
WOMPI_CURRENCY=COP
